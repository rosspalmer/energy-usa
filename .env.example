# EIA API (required for Prefect ingest flows). Get a key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=
EIA_BASE_URL=https://api.eia.gov/v2

# Anthropic Claude (required for jupyter-ai integration in Jupyter Lab)
# Get a key: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Postgres (used by Docker Compose, Prefect worker, and Django web app)
POSTGRES_USER=energy
POSTGRES_PASSWORD=energy
POSTGRES_DB=energy_usa
DATABASE_URL=postgresql://energy:energy@localhost:5432/energy_usa
# EIA raw data (ingest flows write here; Django dashboard reads from here).
# Set this so `make backfill` writes to the correct database even when DATABASE_URL points to the app db.
# Docker Compose worker sets DATABASE_URL to ingest directly; for local dev set INGEST_DATABASE_URL.
INGEST_DATABASE_URL=postgresql://energy:energy@localhost:5432/ingest

# Django (optional; used by web service in Docker or local run)
# DJANGO_SECRET_KEY=change-me-in-production
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: EIA manager and ingest limits
# EIA_REQUEST_TIMEOUT_SECONDS=30
# EIA_INGEST_TIMEOUT_SECONDS=90
# EIA_PAGE_DELAY_SECONDS=0.5
# EIA_MAX_CONCURRENT_REQUESTS=4
# EIA_MAX_RETRIES=5
