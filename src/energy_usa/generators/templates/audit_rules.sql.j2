{% for nt in ds.null_tolerances %}
INSERT INTO quality.audit_rules (rule_id, source, dataset, check_type, column_name, threshold, enabled)
VALUES (
    '{{ spec.source }}.{{ ds.name }}.null_rate.{{ nt.column }}',
