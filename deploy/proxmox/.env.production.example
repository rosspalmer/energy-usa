# Production environment for Proxmox LXC deployment.
# Copy to .env in the repo root on each LXC and fill in real values.
#
#   cp deploy/proxmox/.env.production.example .env
#
# The app and jupyter LXCs each need their own copy of this file.
# The postgres LXC does not use this file.

# ── EIA API ───────────────────────────────────────────────────────────────────
# Register at https://www.eia.gov/opendata/register.php
EIA_API_KEY=your-eia-api-key-here

# ── Postgres LXC ──────────────────────────────────────────────────────────────
# IP address of the postgres LXC (set in create-lxc.sh, default 192.168.1.10)
POSTGRES_HOST=192.168.1.10
POSTGRES_USER=energy
POSTGRES_PASSWORD=changeme

# ── Prefect ───────────────────────────────────────────────────────────────────
# Only needed if running dock.sh or deploy scripts from outside the app LXC.
PREFECT_API_URL=http://192.168.1.11:4200/api

# ── AI / Jupyter ──────────────────────────────────────────────────────────────
# Required for jupyter-ai Claude integration in Jupyter Lab.
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Superset ──────────────────────────────────────────────────────────────────
# Generate a secret key: python -c "import secrets; print(secrets.token_hex(42))"
SUPERSET_SECRET_KEY=replace-with-a-long-random-string

# Admin credentials (set once; used by superset-init on first run)
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_EMAIL=admin@energy.local
SUPERSET_ADMIN_PASSWORD=replace-with-a-strong-password

# Set to "true" if Superset is behind a reverse proxy (nginx, Caddy) — enables
# proxy headers so the correct client IP and scheme are preserved.
SUPERSET_PROXY_FIX=false

# Set to "true" if Superset is served over HTTPS — marks the session cookie Secure.
# Requires SUPERSET_PROXY_FIX=true when behind a TLS-terminating proxy.
SUPERSET_COOKIE_SECURE=false

# ── EIA ingest tuning (optional) ─────────────────────────────────────────────
EIA_BASE_URL=https://api.eia.gov/v2
EIA_REQUEST_TIMEOUT_SECONDS=30
EIA_INGEST_TIMEOUT_SECONDS=90
EIA_PAGE_DELAY_SECONDS=0.5
EIA_MAX_CONCURRENT_REQUESTS=4
EIA_MAX_RETRIES=5
