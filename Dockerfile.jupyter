# Jupyter notebooks: project deps (base + web + notebook), run JupyterLab.
# Use python:3.12-slim and install uv via pip to avoid pulling from ghcr.io (helps with proxy/firewall).
FROM python:3.12-slim AS builder
RUN pip install --no-cache-dir uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project --extra web --extra notebook
COPY . .
RUN uv sync --frozen --no-dev --extra web --extra notebook

FROM python:3.12-slim
WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app/src"
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/src /app/src
COPY --from=builder /app/pyproject.toml /app/
RUN mkdir -p /app/notebooks
EXPOSE 8888
# No token/password for local-dev compose; bind all interfaces.
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root", "--ServerApp.token=", "--ServerApp.password="]
