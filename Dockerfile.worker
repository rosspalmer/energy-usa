# Prefect worker: project code and deps so the ingest flow runs in-process.
# Use python:3.12-slim and install uv via pip to avoid pulling from ghcr.io (helps with proxy/firewall).
FROM python:3.12-slim AS builder
RUN pip install --no-cache-dir uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY . .
RUN uv sync --frozen --no-dev

FROM python:3.12-slim
WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH"
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/src /app/src
COPY --from=builder /app/pyproject.toml /app/
# Process worker runs flows in-process; needs EIA_API_KEY, DATABASE_URL, PREFECT_API_URL at runtime.
# Create process work pool if missing: prefect work-pool create process-pool --type process
CMD ["prefect", "worker", "start", "--pool", "process-pool", "--type", "process"]
