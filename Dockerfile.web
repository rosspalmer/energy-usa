# Django+Dash web app: install deps with uv (including web extra), run gunicorn.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project --extra web
COPY . .
RUN uv sync --frozen --no-dev --extra web

FROM python:3.12-slim
WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app/web"
ENV DJANGO_SETTINGS_MODULE=config.settings
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/web /app/web
COPY --from=builder /app/pyproject.toml /app/
EXPOSE 8000
# Run migrate then gunicorn (migrate needs DATABASE_URL at runtime)
COPY docker/web/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2"]
